# Cópia para .env.local (não versionado)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=dash_jira

JIRA_BASE_URL=https://sua-org.atlassian.net
JIRA_EMAIL=email@empresa.com
JIRA_API_TOKEN=seu_token_api
# Story Points (projeto SV team-managed): costuma ser customfield_10016 — confirme numa issue.
JIRA_STORY_POINTS_FIELD=customfield_10016

# Sprint ID = id numérico Agile (não é o board id). Board SV/1 sprint ativa (API): 104 — "Quadro Sprint 6".
